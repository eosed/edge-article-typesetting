{
  "manifest_version": 3,
  "name": "网页文章规范化排版",
  "version": "0.2.0",
  "description": "一键排版网页富文本编辑器（UEditor 等）中的文章：先清除全部格式，再统一为 22px 字号、1.5 倍行距、中文宋体、英文与罗马数字 Times New Roman、图片与图标题居中。",
  "author": "eosed",
  "minimum_chrome_version": "111",
  "permissions": ["scripting", "activeTab"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "排版当前文章",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/engine.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/bridge.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
